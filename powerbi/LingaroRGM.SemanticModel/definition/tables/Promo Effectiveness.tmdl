/// Promotion results by brand and mechanic at the ASSUMED 30% margin
table 'Promo Effectiveness'

	column brand_key
		dataType: string
		summarizeBy: none
		sourceColumn: brand_key

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column manufacturer
		dataType: string
		summarizeBy: none
		sourceColumn: manufacturer

	column promo_type
		dataType: string
		summarizeBy: none
		sourceColumn: promo_type

	column promo_weeks
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: promo_weeks

	column units
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: units

	column baseline_units
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: baseline_units

	column avg_discount
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: avg_discount

	column incr_units
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: incr_units

	column incr_revenue
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: incr_revenue

	column discount_cost
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: discount_cost

	column net_incr_profit
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: net_incr_profit

	column paid_back_weeks
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: paid_back_weeks

	column uplift
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: uplift

	column roi
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: roi

	column share_weeks_paid_back
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: share_weeks_paid_back

	partition 'Promo Effectiveness' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "output\promo_effectiveness.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Kept = Table.SelectColumns(Promoted, {"brand_key", "category", "manufacturer", "promo_type", "promo_weeks", "units", "baseline_units", "avg_discount", "incr_units", "incr_revenue", "discount_cost", "net_incr_profit", "paid_back_weeks", "uplift", "roi", "share_weeks_paid_back"}, MissingField.UseNull),
			    Typed = Table.TransformColumnTypes(Kept, {{"brand_key", type text}, {"category", type text}, {"manufacturer", type text}, {"promo_type", type text}, {"promo_weeks", Int64.Type}, {"units", type number}, {"baseline_units", type number}, {"avg_discount", type number}, {"incr_units", type number}, {"incr_revenue", type number}, {"discount_cost", type number}, {"net_incr_profit", type number}, {"paid_back_weeks", Int64.Type}, {"uplift", type number}, {"roi", type number}, {"share_weeks_paid_back", type number}}, "en-US")
			in
			    Typed
