/// Non-promoted products when another product of the category is on promotion
table Cannibalisation

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column context
		dataType: string
		summarizeBy: none
		sourceColumn: context

	column weeks
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: weeks

	column units
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: units

	column baseline_units
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: baseline_units

	column vs_baseline
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: vs_baseline

	partition Cannibalisation = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "output\cannibalisation.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Kept = Table.SelectColumns(Promoted, {"category", "context", "weeks", "units", "baseline_units", "vs_baseline"}, MissingField.UseNull),
			    Typed = Table.TransformColumnTypes(Kept, {{"category", type text}, {"context", type text}, {"weeks", Int64.Type}, {"units", type number}, {"baseline_units", type number}, {"vs_baseline", type number}}, "en-US")
			in
			    Typed
