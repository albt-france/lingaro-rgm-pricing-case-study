/// Stores; state is used as the 'market' for the cross-market template
table Store

	column store_id
		dataType: int64
		summarizeBy: none
		sourceColumn: store_id

	column store_name
		dataType: string
		summarizeBy: none
		sourceColumn: store_name

	column city
		dataType: string
		summarizeBy: none
		sourceColumn: city

	column state
		dataType: string
		summarizeBy: none
		sourceColumn: state

	column segment
		dataType: string
		summarizeBy: none
		sourceColumn: segment

	column sales_area_sqft
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: sales_area_sqft

	partition Store = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "clean\stores.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Kept = Table.SelectColumns(Promoted, {"store_id", "store_name", "city", "state", "segment", "sales_area_sqft"}, MissingField.UseNull),
			    Typed = Table.TransformColumnTypes(Kept, {{"store_id", Int64.Type}, {"store_name", type text}, {"city", type text}, {"state", type text}, {"segment", type text}, {"sales_area_sqft", type number}}, "en-US")
			in
			    Typed
