/// SIMULATED NielsenIQ/Circana-style market data (seed 42) - not real
table 'Market Sim'

	column brand_key
		dataType: string
		summarizeBy: none
		sourceColumn: brand_key

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column manufacturer
		dataType: string
		summarizeBy: none
		sourceColumn: manufacturer

	column quarter
		dataType: string
		summarizeBy: none
		sourceColumn: quarter

	column market_value
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: market_value

	column market_value_share
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: market_value_share

	column retailer_revenue
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: retailer_revenue

	column retailer_value_share
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: retailer_value_share

	column retailer_price
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: retailer_price

	column competitor_avg_price
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: competitor_avg_price

	column price_index_vs_competitors
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: price_index_vs_competitors

	column numeric_distribution
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: numeric_distribution

	column weighted_distribution
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: weighted_distribution

	column data_label
		dataType: string
		summarizeBy: none
		sourceColumn: data_label

	partition 'Market Sim' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "output\market_sim.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Kept = Table.SelectColumns(Promoted, {"brand_key", "category", "manufacturer", "quarter", "market_value", "market_value_share", "retailer_revenue", "retailer_value_share", "retailer_price", "competitor_avg_price", "price_index_vs_competitors", "numeric_distribution", "weighted_distribution", "data_label"}, MissingField.UseNull),
			    Typed = Table.TransformColumnTypes(Kept, {{"brand_key", type text}, {"category", type text}, {"manufacturer", type text}, {"quarter", type text}, {"market_value", type number}, {"market_value_share", type number}, {"retailer_revenue", type number}, {"retailer_value_share", type number}, {"retailer_price", type number}, {"competitor_avg_price", type number}, {"price_index_vs_competitors", type number}, {"numeric_distribution", type number}, {"weighted_distribution", type number}, {"data_label", type text}}, "en-US")
			in
			    Typed
