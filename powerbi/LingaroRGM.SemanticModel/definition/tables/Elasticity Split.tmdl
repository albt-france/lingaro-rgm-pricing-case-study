/// Regular-price vs promo-price-cut elasticity by category
table 'Elasticity Split'

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column component
		dataType: string
		summarizeBy: none
		sourceColumn: component

	column elasticity
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: elasticity

	column ci_low
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: ci_low

	column ci_high
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: ci_high

	column p_value
		dataType: double
		formatString: 0.0000
		summarizeBy: none
		sourceColumn: p_value

	column n_obs
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: n_obs

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column note
		dataType: string
		summarizeBy: none
		sourceColumn: note

	partition 'Elasticity Split' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "output\elasticity_split.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Kept = Table.SelectColumns(Promoted, {"category", "component", "elasticity", "ci_low", "ci_high", "p_value", "n_obs", "status", "note"}, MissingField.UseNull),
			    Typed = Table.TransformColumnTypes(Kept, {{"category", type text}, {"component", type text}, {"elasticity", type number}, {"ci_low", type number}, {"ci_high", type number}, {"p_value", type number}, {"n_obs", Int64.Type}, {"status", type text}, {"note", type text}}, "en-US")
			in
			    Typed
