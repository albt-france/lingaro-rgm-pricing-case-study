/// Post-promotion dip by category
table 'Promo Dip'

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column post_weeks
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: post_weeks

	column units
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: units

	column baseline_units
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: baseline_units

	column dip
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: dip

	column dip_units
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: dip_units

	partition 'Promo Dip' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "output\promo_dip.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Kept = Table.SelectColumns(Promoted, {"category", "post_weeks", "units", "baseline_units", "dip", "dip_units"}, MissingField.UseNull),
			    Typed = Table.TransformColumnTypes(Kept, {{"category", type text}, {"post_weeks", Int64.Type}, {"units", type number}, {"baseline_units", type number}, {"dip", type number}, {"dip_units", type number}}, "en-US")
			in
			    Typed
