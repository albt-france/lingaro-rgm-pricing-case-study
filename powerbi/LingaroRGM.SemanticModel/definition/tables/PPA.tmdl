/// Price-pack architecture: regular price per ounce by pack
table PPA

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column sub_category
		dataType: string
		summarizeBy: none
		sourceColumn: sub_category

	column manufacturer
		dataType: string
		summarizeBy: none
		sourceColumn: manufacturer

	column upc
		dataType: int64
		summarizeBy: none
		sourceColumn: upc

	column description
		dataType: string
		summarizeBy: none
		sourceColumn: description

	column size
		dataType: string
		summarizeBy: none
		sourceColumn: size

	column size_oz
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: size_oz

	column units
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: units

	column avg_base_price
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: avg_base_price

	column base_price_per_oz
		dataType: double
		formatString: $0.000
		summarizeBy: none
		sourceColumn: base_price_per_oz

	column elasticity
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: elasticity

	column price_index_per_oz
		dataType: double
		formatString: 0
		summarizeBy: none
		sourceColumn: price_index_per_oz

	column inverted_vs
		dataType: string
		summarizeBy: none
		sourceColumn: inverted_vs

	column inversion_premium
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: inversion_premium

	column opportunity
		dataType: string
		summarizeBy: none
		sourceColumn: opportunity

	partition PPA = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "output\ppa.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Kept = Table.SelectColumns(Promoted, {"category", "sub_category", "manufacturer", "upc", "description", "size", "size_oz", "units", "avg_base_price", "base_price_per_oz", "elasticity", "price_index_per_oz", "inverted_vs", "inversion_premium", "opportunity"}, MissingField.UseNull),
			    Typed = Table.TransformColumnTypes(Kept, {{"category", type text}, {"sub_category", type text}, {"manufacturer", type text}, {"upc", Int64.Type}, {"description", type text}, {"size", type text}, {"size_oz", type number}, {"units", type number}, {"avg_base_price", type number}, {"base_price_per_oz", type number}, {"elasticity", type number}, {"price_index_per_oz", type number}, {"inverted_vs", type text}, {"inversion_premium", type number}, {"opportunity", type text}}, "en-US")
			in
			    Typed
