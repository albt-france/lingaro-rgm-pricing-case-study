			formatString: #,0
			summarizeBy: none
			sourceColumn: units

		column avg_base_price
			dataType: double
			formatString: $#,0.00
			summarizeBy: none
			sourceColumn: avg_base_price

		column base_price_per_oz
			dataType: double
			formatString: $0.000
			summarizeBy: none
			sourceColumn: base_price_per_oz

		column elasticity
