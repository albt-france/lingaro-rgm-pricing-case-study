			summarizeBy: none
			sourceColumn: segment

		column price_change
			dataType: double
			formatString: +0%;-0%;0%
			summarizeBy: none
			sourceColumn: price_change

		column volume_pct
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: volume_pct

		column volume_pct_low
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: volume_pct_low

		column volume_pct_high
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: volume_pct_high

		column revenue_pct
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: revenue_pct

		column revenue_pct_low
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: revenue_pct_low

		column revenue_pct_high
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: revenue_pct_high

		column profit_pct
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: profit_pct

		column profit_pct_low
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: profit_pct_low

		column profit_pct_high
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: profit_pct_high

		column revenue_delta
			dataType: double
			formatString: $#,0
			summarizeBy: none
			sourceColumn: revenue_delta

		column profit_delta
			dataType: double
			formatString: $#,0
			summarizeBy: none
			sourceColumn: profit_delta

		partition 'Scenario Grid' = m
			mode: import
			source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "output\scenario_grid.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"segment_id", "level", "segment", "price_change", "volume_pct", "volume_pct_low", "volume_pct_high", "revenue_pct", "revenue_pct_low", "revenue_pct_high", "profit_pct", "profit_pct_low", "profit_pct_high", "revenue_delta", "profit_delta"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"segment_id", Int64.Type}, {"level", type text}, {"segment", type text}, {"price_change", type number}, {"volume_pct", type number}, {"volume_pct_low", type number}, {"volume_pct_high", type number}, {"revenue_pct", type number}, {"revenue_pct_low", type number}, {"revenue_pct_high", type number}, {"profit_pct", type number}, {"profit_pct_low", type number}, {"profit_pct_high", type number}, {"revenue_delta", type number}, {"profit_delta", type number}}, "en-US")
				in
				    Typed

