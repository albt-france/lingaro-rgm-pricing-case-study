createOrReplace

	expression DataFolder = "C:\lingaro-case-study\data\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	/// REAL RETAIL DATA - weekly sales by store and product (dunnhumby Breakfast at the Frat), with promo baseline
	table Sales

		column week_end_date
			dataType: dateTime
			summarizeBy: none
			sourceColumn: week_end_date

			annotation UnderlyingDateTimeDataType = Date

		column store_id
			dataType: int64
			summarizeBy: none
			sourceColumn: store_id

		column upc
			dataType: int64
			summarizeBy: none
			sourceColumn: upc

		column units
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: units

		column spend
			dataType: double
			formatString: $#,0.00
			summarizeBy: none
			sourceColumn: spend

		column price
			dataType: double
			formatString: $#,0.00
			summarizeBy: none
			sourceColumn: price

		column base_price
			dataType: double
			formatString: $#,0.00
			summarizeBy: none
			sourceColumn: base_price

		column discount_pct
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: discount_pct

		column feature
			dataType: int64
			summarizeBy: none
			sourceColumn: feature

		column display
			dataType: int64
			summarizeBy: none
			sourceColumn: display

		column tpr_only
			dataType: int64
			summarizeBy: none
			sourceColumn: tpr_only

		column promo_type
			dataType: string
			summarizeBy: none
			sourceColumn: promo_type

		column is_promo
			dataType: int64
			summarizeBy: none
			sourceColumn: is_promo

		column dq_ok
			dataType: int64
			summarizeBy: none
			sourceColumn: dq_ok

		column baseline_units
			dataType: double
			formatString: #,0.00
			summarizeBy: none
			sourceColumn: baseline_units

		column baseline_n_weeks
			dataType: int64
			summarizeBy: none
			sourceColumn: baseline_n_weeks

		column is_post_promo_week
			dataType: int64
			summarizeBy: none
			sourceColumn: is_post_promo_week

		partition Sales = m
			mode: import
			source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "clean\sales_promo_weekly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"week_end_date", "store_id", "upc", "units", "spend", "price", "base_price", "discount_pct", "feature", "display", "tpr_only", "promo_type", "is_promo", "dq_ok", "baseline_units", "baseline_n_weeks", "is_post_promo_week"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"week_end_date", type date}, {"store_id", Int64.Type}, {"upc", Int64.Type}, {"units", Int64.Type}, {"spend", type number}, {"price", type number}, {"base_price", type number}, {"discount_pct", type number}, {"feature", Int64.Type}, {"display", Int64.Type}, {"tpr_only", Int64.Type}, {"promo_type", type text}, {"is_promo", Int64.Type}, {"dq_ok", Int64.Type}, {"baseline_units", type number}, {"baseline_n_weeks", Int64.Type}, {"is_post_promo_week", Int64.Type}}, "en-US")
				in
				    Typed

	/// Product hierarchy: category > manufacturer (brand) > product > pack size
	table Product

		column upc
			dataType: int64
			summarizeBy: none
			sourceColumn: upc

		column product_name
			dataType: string
			summarizeBy: none
			sourceColumn: product_name

		column description
			dataType: string
			summarizeBy: none
			sourceColumn: description

		column manufacturer
			dataType: string
			summarizeBy: none
			sourceColumn: manufacturer

		column category
			dataType: string
			summarizeBy: none
			sourceColumn: category

		column sub_category
			dataType: string
			summarizeBy: none
			sourceColumn: sub_category

		column size
			dataType: string
			summarizeBy: none
			sourceColumn: size

		column size_oz
			dataType: double
			formatString: #,0.00
			summarizeBy: none
			sourceColumn: size_oz

		column brand_key
			dataType: string
			summarizeBy: none
			sourceColumn: brand_key

		column is_private_label
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_private_label

		column phase_out
			dataType: int64
			summarizeBy: none
			sourceColumn: phase_out

		partition Product = m
			mode: import
			source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "clean\products.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"upc", "product_name", "description", "manufacturer", "category", "sub_category", "size", "size_oz", "brand_key", "is_private_label", "phase_out"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"upc", Int64.Type}, {"product_name", type text}, {"description", type text}, {"manufacturer", type text}, {"category", type text}, {"sub_category", type text}, {"size", type text}, {"size_oz", type number}, {"brand_key", type text}, {"is_private_label", type logical}, {"phase_out", Int64.Type}}, "en-US")
				in
				    Typed

	/// Stores; state is used as the 'market' for the cross-market template
	table Store

		column store_id
			dataType: int64
			summarizeBy: none
			sourceColumn: store_id

		column store_name
			dataType: string
			summarizeBy: none
			sourceColumn: store_name

		column city
			dataType: string
			summarizeBy: none
			sourceColumn: city

		column state
			dataType: string
			summarizeBy: none
			sourceColumn: state

		column segment
			dataType: string
			summarizeBy: none
			sourceColumn: segment

		column sales_area_sqft
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: sales_area_sqft

		partition Store = m
			mode: import
			source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "clean\stores.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"store_id", "store_name", "city", "state", "segment", "sales_area_sqft"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"store_id", Int64.Type}, {"store_name", type text}, {"city", type text}, {"state", type text}, {"segment", type text}, {"sales_area_sqft", type number}}, "en-US")
				in
				    Typed

	/// Log-log price elasticities with 95% intervals and publication status (business rule BR-06)
	table Elasticity

		column segment_id
			dataType: int64
			summarizeBy: none
			sourceColumn: segment_id

		column level
			dataType: string
			summarizeBy: none
			sourceColumn: level

		column segment
			dataType: string
			summarizeBy: none
			sourceColumn: segment

		column category
			dataType: string
			summarizeBy: none
			sourceColumn: category

		column manufacturer
			dataType: string
			summarizeBy: none
			sourceColumn: manufacturer

		column market
			dataType: string
			summarizeBy: none
			sourceColumn: market

		column upc
			dataType: double
			summarizeBy: none
			sourceColumn: upc

		column n_obs
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: n_obs

		column n_stores
			dataType: int64
			summarizeBy: none
			sourceColumn: n_stores

		column n_products
			dataType: int64
			summarizeBy: none
			sourceColumn: n_products

		column n_weeks
			dataType: int64
			summarizeBy: none
			sourceColumn: n_weeks

		column price_sd
			dataType: double
			formatString: 0.000
			summarizeBy: none
			sourceColumn: price_sd

		column base_units_52w
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: base_units_52w

		column base_revenue_52w
			dataType: double
			formatString: $#,0
			summarizeBy: none
			sourceColumn: base_revenue_52w

		column avg_price_52w
			dataType: double
			formatString: $#,0.00
			summarizeBy: none
			sourceColumn: avg_price_52w

		column elasticity
			dataType: double
			formatString: 0.00
			summarizeBy: none
			sourceColumn: elasticity

		column se
			dataType: double
			formatString: 0.000
			summarizeBy: none
			sourceColumn: se

		column ci_low
			dataType: double
			formatString: 0.00
			summarizeBy: none
			sourceColumn: ci_low

		column ci_high
			dataType: double
			formatString: 0.00
			summarizeBy: none
			sourceColumn: ci_high

		column p_value
			dataType: double
			formatString: 0.0000
			summarizeBy: none
			sourceColumn: p_value

		column r2
			dataType: double
			formatString: 0.000
			summarizeBy: none
			sourceColumn: r2

		column feature_effect
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: feature_effect

		column display_effect
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: display_effect

		column status
			dataType: string
			summarizeBy: none
			sourceColumn: status

		column status_reason
			dataType: string
			summarizeBy: none
			sourceColumn: status_reason

		column plain_english
			dataType: string
			summarizeBy: none
			sourceColumn: plain_english

		partition Elasticity = m
			mode: import
			source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "output\elasticity.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"segment_id", "level", "segment", "category", "manufacturer", "market", "upc", "n_obs", "n_stores", "n_products", "n_weeks", "price_sd", "base_units_52w", "base_revenue_52w", "avg_price_52w", "elasticity", "se", "ci_low", "ci_high", "p_value", "r2", "feature_effect", "display_effect", "status", "status_reason", "plain_english"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"segment_id", Int64.Type}, {"level", type text}, {"segment", type text}, {"category", type text}, {"manufacturer", type text}, {"market", type text}, {"upc", type number}, {"n_obs", Int64.Type}, {"n_stores", Int64.Type}, {"n_products", Int64.Type}, {"n_weeks", Int64.Type}, {"price_sd", type number}, {"base_units_52w", type number}, {"base_revenue_52w", type number}, {"avg_price_52w", type number}, {"elasticity", type number}, {"se", type number}, {"ci_low", type number}, {"ci_high", type number}, {"p_value", type number}, {"r2", type number}, {"feature_effect", type number}, {"display_effect", type number}, {"status", type text}, {"status_reason", type text}, {"plain_english", type text}}, "en-US")
				in
				    Typed

	/// Regular-price vs promo-price-cut elasticity by category
	table 'Elasticity Split'

		column category
			dataType: string
			summarizeBy: none
			sourceColumn: category

		column component
			dataType: string
			summarizeBy: none
			sourceColumn: component

		column elasticity
			dataType: double
			formatString: 0.00
			summarizeBy: none
			sourceColumn: elasticity

		column ci_low
			dataType: double
			formatString: 0.00
			summarizeBy: none
			sourceColumn: ci_low

		column ci_high
			dataType: double
			formatString: 0.00
			summarizeBy: none
			sourceColumn: ci_high

		column p_value
			dataType: double
			formatString: 0.0000
			summarizeBy: none
			sourceColumn: p_value

		column n_obs
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: n_obs

		column status
			dataType: string
			summarizeBy: none
			sourceColumn: status

		column note
			dataType: string
			summarizeBy: none
			sourceColumn: note

		partition 'Elasticity Split' = m
			mode: import
			source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "output\elasticity_split.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"category", "component", "elasticity", "ci_low", "ci_high", "p_value", "n_obs", "status", "note"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"category", type text}, {"component", type text}, {"elasticity", type number}, {"ci_low", type number}, {"ci_high", type number}, {"p_value", type number}, {"n_obs", Int64.Type}, {"status", type text}, {"note", type text}}, "en-US")
				in
				    Typed

	/// Brand units vs rest-of-category price
	table 'Cross Elasticity'

		column category
			dataType: string
			summarizeBy: none
			sourceColumn: category

		column manufacturer
			dataType: string
			summarizeBy: none
			sourceColumn: manufacturer

		column n_obs
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: n_obs

		column own_elasticity
			dataType: double
			formatString: 0.00
			summarizeBy: none
			sourceColumn: own_elasticity

		column cross_elasticity
			dataType: double
			formatString: 0.00
			summarizeBy: none
			sourceColumn: cross_elasticity

		column ci_low
			dataType: double
			formatString: 0.00
			summarizeBy: none
			sourceColumn: ci_low

		column ci_high
			dataType: double
			formatString: 0.00
			summarizeBy: none
			sourceColumn: ci_high

		column p_value
			dataType: double
			formatString: 0.0000
			summarizeBy: none
			sourceColumn: p_value

		column reading
			dataType: string
			summarizeBy: none
			sourceColumn: reading

		partition 'Cross Elasticity' = m
			mode: import
			source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "output\cross_elasticity.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"category", "manufacturer", "n_obs", "own_elasticity", "cross_elasticity", "ci_low", "ci_high", "p_value", "reading"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"category", type text}, {"manufacturer", type text}, {"n_obs", Int64.Type}, {"own_elasticity", type number}, {"cross_elasticity", type number}, {"ci_low", type number}, {"ci_high", type number}, {"p_value", type number}, {"reading", type text}}, "en-US")
				in
				    Typed

	/// Promotion results by brand and mechanic at the ASSUMED 30% margin
	table 'Promo Effectiveness'

		column brand_key
			dataType: string
			summarizeBy: none
			sourceColumn: brand_key

		column category
			dataType: string
			summarizeBy: none
			sourceColumn: category

		column manufacturer
			dataType: string
			summarizeBy: none
			sourceColumn: manufacturer

		column promo_type
			dataType: string
			summarizeBy: none
			sourceColumn: promo_type

		column promo_weeks
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: promo_weeks

		column units
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: units

		column baseline_units
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: baseline_units

		column avg_discount
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: avg_discount

		column incr_units
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: incr_units

		column incr_revenue
			dataType: double
			formatString: $#,0
			summarizeBy: none
			sourceColumn: incr_revenue

		column discount_cost
			dataType: double
			formatString: $#,0
			summarizeBy: none
			sourceColumn: discount_cost

		column net_incr_profit
			dataType: double
			formatString: $#,0
			summarizeBy: none
			sourceColumn: net_incr_profit

		column paid_back_weeks
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: paid_back_weeks

		column uplift
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: uplift

		column roi
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: roi

		column share_weeks_paid_back
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: share_weeks_paid_back

		partition 'Promo Effectiveness' = m
			mode: import
			source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "output\promo_effectiveness.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"brand_key", "category", "manufacturer", "promo_type", "promo_weeks", "units", "baseline_units", "avg_discount", "incr_units", "incr_revenue", "discount_cost", "net_incr_profit", "paid_back_weeks", "uplift", "roi", "share_weeks_paid_back"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"brand_key", type text}, {"category", type text}, {"manufacturer", type text}, {"promo_type", type text}, {"promo_weeks", Int64.Type}, {"units", type number}, {"baseline_units", type number}, {"avg_discount", type number}, {"incr_units", type number}, {"incr_revenue", type number}, {"discount_cost", type number}, {"net_incr_profit", type number}, {"paid_back_weeks", Int64.Type}, {"uplift", type number}, {"roi", type number}, {"share_weeks_paid_back", type number}}, "en-US")
				in
				    Typed

	/// Promotion results by category and mechanic, margin sensitivity 20/30/40%
	table 'Promo Summary'

		column category
			dataType: string
			summarizeBy: none
			sourceColumn: category

		column promo_type
			dataType: string
			summarizeBy: none
			sourceColumn: promo_type

		column promo_weeks
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: promo_weeks

		column avg_discount
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: avg_discount

		column uplift
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: uplift

		column incr_units
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: incr_units

		column discount_cost
			dataType: double
			formatString: $#,0
			summarizeBy: none
			sourceColumn: discount_cost

		column net_incr_profit
			dataType: double
			formatString: $#,0
			summarizeBy: none
			sourceColumn: net_incr_profit

		column roi
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: roi

		column margin_assumption
			dataType: double
			formatString: 0%
			summarizeBy: none
			sourceColumn: margin_assumption

		column dip
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: dip

		column net_incr_profit_after_dip
			dataType: double
			formatString: $#,0
			summarizeBy: none
			sourceColumn: net_incr_profit_after_dip

		column roi_after_dip
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: roi_after_dip

		partition 'Promo Summary' = m
			mode: import
			source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "output\promo_summary.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"category", "promo_type", "promo_weeks", "avg_discount", "uplift", "incr_units", "discount_cost", "net_incr_profit", "roi", "margin_assumption", "dip", "net_incr_profit_after_dip", "roi_after_dip"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"category", type text}, {"promo_type", type text}, {"promo_weeks", Int64.Type}, {"avg_discount", type number}, {"uplift", type number}, {"incr_units", type number}, {"discount_cost", type number}, {"net_incr_profit", type number}, {"roi", type number}, {"margin_assumption", type number}, {"dip", type number}, {"net_incr_profit_after_dip", type number}, {"roi_after_dip", type number}}, "en-US")
				in
				    Typed

	/// Post-promotion dip by category
	table 'Promo Dip'

		column category
			dataType: string
			summarizeBy: none
			sourceColumn: category

		column post_weeks
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: post_weeks

		column units
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: units

		column baseline_units
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: baseline_units

		column dip
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: dip

		column dip_units
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: dip_units

		partition 'Promo Dip' = m
			mode: import
			source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "output\promo_dip.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"category", "post_weeks", "units", "baseline_units", "dip", "dip_units"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"category", type text}, {"post_weeks", Int64.Type}, {"units", type number}, {"baseline_units", type number}, {"dip", type number}, {"dip_units", type number}}, "en-US")
				in
				    Typed

	/// Non-promoted products when another product of the category is on promotion
	table Cannibalisation

		column category
			dataType: string
			summarizeBy: none
			sourceColumn: category

		column context
			dataType: string
			summarizeBy: none
			sourceColumn: context

		column weeks
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: weeks

		column units
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: units

		column baseline_units
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: baseline_units

		column vs_baseline
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: vs_baseline

		partition Cannibalisation = m
			mode: import
			source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "output\cannibalisation.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"category", "context", "weeks", "units", "baseline_units", "vs_baseline"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"category", type text}, {"context", type text}, {"weeks", Int64.Type}, {"units", type number}, {"baseline_units", type number}, {"vs_baseline", type number}}, "en-US")
				in
				    Typed

	/// Price-pack architecture: regular price per ounce by pack
	table PPA

		column category
