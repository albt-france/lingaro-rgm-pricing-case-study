				    Kept = Table.SelectColumns(Promoted, {"category", "sub_category", "manufacturer", "upc", "description", "size", "size_oz", "units", "avg_base_price", "base_price_per_oz", "elasticity", "price_index_per_oz", "inverted_vs", "inversion_premium", "opportunity"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"category", type text}, {"sub_category", type text}, {"manufacturer", type text}, {"upc", Int64.Type}, {"description", type text}, {"size", type text}, {"size_oz", type number}, {"units", type number}, {"avg_base_price", type number}, {"base_price_per_oz", type number}, {"elasticity", type number}, {"price_index_per_oz", type number}, {"inverted_vs", type text}, {"inversion_premium", type number}, {"opportunity", type text}}, "en-US")
				in
				    Typed

	/// Pre-computed scenarios -10%..+10% (oracle for the DAX simulator)
	table 'Scenario Grid'

		column segment_id
			dataType: int64
			summarizeBy: none
			sourceColumn: segment_id

		column level
